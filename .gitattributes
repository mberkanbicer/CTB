.gitattributes    export-ignore
.gitignore        export-ignore

# Touchstone fixtures are compared byte for byte with the Octave-written
# reference files, so they must keep their committed bytes on every platform.
rust/tests/data/** -text

# The Octave exercises and shell helpers are executed on Linux/Windows hosts.
rust/tests/octave/** text eol=lf
*.sh text eol=lf
